{
  "name": "cnn_large",
  "seed": 42,
  "model": {
    "img_size": 224,
    "num_classes": 200,
    "widths": [
      64,
      128,
      256,
      512
    ],
    "blocks": [
      2,
      2,
      2,
      2
    ],
    "zero_init_residual": true
  },
  "train": {
    "epochs": 300,
    "batch_size": 64,
    "lr": 0.0005,
    "min_lr": 1e-06,
    "warmup_epochs": 10,
    "weight_decay": 0.05,
    "betas": [
      0.9,
      0.999
    ],
    "grad_clip": 1.0,
    "label_smoothing": 0.1,
    "amp": true,
    "aug_tier": "strong",
    "use_mixup_cutmix": true,
    "use_bbox_loss": false,
    "bbox_weight": 0.1,
    "use_ema": true,
    "ema_decay": 0.999,
    "use_consistency": false,
    "cons_logit_weight": 1.0,
    "cons_attn_weight": 1.0,
    "use_box_crop": false,
    "box_crop_prob": 0.3,
    "box_crop_margin": [
      0.1,
      0.4
    ],
    "best_metric": "acc1",
    "early_stop_patience": 60,
    "early_stop_start": 30,
    "clean_eval_every": 5,
    "clean_eval_size": 600,
    "snapshot_every": 10,
    "weights_every": 50,
    "plot_every": 10
  }
}